# === PitchNama .gitignore ===

# Data files (Cricsheet downloads — these are huge and downloadable from source)
# Raw Cricsheet downloads — too large for Git
data/*.zip
data/ipl_json/
data/t20i_json/
data/odi_json/
data/test_json/
data/bbl_json/
data/psl_json/
data/cpl_json/
*.zip

# Jupyter notebook checkpoints (auto-generated backups)
.ipynb_checkpoints/

# Python cache files
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
env/
.venv/

# Node / front-end build artifacts (NOT package.json or package-lock.json — those MUST be tracked)
node_modules/
frontend/dist/
frontend/dist-ssr/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / editor files
.vscode/
.idea/
*.swp

# Output / generated files
*.log
*.tmp

# Environment variable files (NEVER commit secrets)
.env
.env.local