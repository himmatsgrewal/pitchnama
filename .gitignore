# === PitchNama .gitignore ===

# Data files (Cricsheet downloads — these are huge and downloadable from source)
# Raw Cricsheet downloads — too large for Git
data/*.zip
data/ipl_json/
data/t20i_json/
data/odi_json/
data/test_json/
data/bbl_json/
data/psl_json/
data/cpl_json/
*.zip
*.json
!pitchnama/player_display_names.json
# Jupyter notebook checkpoints (auto-generated backups)
.ipynb_checkpoints/

# Python cache files
__pycache__/
*.pyc
*.pyo

# Virtual environments (we may set one up later)
venv/
env/
.venv/

# OS-generated files
.DS_Store          # macOS
Thumbs.db          # Windows
desktop.ini        # Windows

# IDE / editor files
.vscode/
.idea/
*.swp

# Output / generated files
*.log
*.tmp

# Environment variable files (NEVER commit secrets)
.env
.env.local